# Copy this file to `.env` and adjust values for your machine.
# Never commit your real `.env` file.

APP_NAME="ResumeIQ API"
APP_VERSION=0.1.0
# One of: development, testing, production
ENVIRONMENT=development
DEBUG=false

# --- Database (PostgreSQL via the psycopg 3 driver) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Homebrew PostgreSQL usually needs no password for your macOS user:
#   postgresql+psycopg://your_macos_username@localhost:5432/resumeiq
DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/resumeiq
# Set to true to log every SQL statement.
DB_ECHO=false

# Separate, disposable database for the test suite. Its name MUST end in
# `_test`; tests wipe and rebuild its schema. Leave unset to skip DB tests.
TEST_DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/resumeiq_test

# Future milestones will add placeholders here, e.g.:
# OPENAI_API_KEY=your-api-key-here
